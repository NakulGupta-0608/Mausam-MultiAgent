# Backend Environment Variables
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather API (open-meteo works without key, or mock-dynamic)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# LLM Providers (for agent reasoning expansion)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
