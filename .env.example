# MausamAI Environment Configuration Example

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather Service Configuration
# Providers: "open-meteo" (free, no key required), "mock-dynamic" (dynamic simulator), "openweather"
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# LLM / AI Configuration (For future agent inference)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# Frontend Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
